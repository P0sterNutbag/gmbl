[sub_resource type="Resource" id="Resource_geuci"]
script = ExtResource("1_mjx3j")
text = "We ain't running a charity. Get ready to die, broke boy!"
metadata/_custom_type_script = "uid://de6rxup5nru4w"

[sub_resource type="Resource" id="Resource_7sw5w"]
