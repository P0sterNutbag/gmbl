[sub_resource type="Resource" id="Resource_02tet"]
script = ExtResource("1_mjx3j")
text = "These parts belong to us! Hand over 50 bucks and we'll spare your life."
metadata/_custom_type_script = "uid://de6rxup5nru4w"

[sub_resource type="Resource" id="Resource_wccyo"]
