[sub_resource type="Resource" id="Resource_alxin"]
script = ExtResource("9_8kgow")
path = "PlayerStats"
value = "arena_level"
comparison = 1
value2 = 0
success_text = "Welcome back, champ! Here to show 'em what your made of again?"
fail_text = "Welcome to the Pit! You got the balls to fight in the greatest tournament around?"
metadata/_custom_type_script = "uid://d36xpf3aobxt1"

[sub_resource type="Resource" id="Resource_8kgow"]
script = ExtResource("2_3qrl7")
text = "Great! The entry fee is $50, but if you win you'll earn $75."
metadata/_custom_type_script = "uid://de6rxup5nru4w"

[sub_resource type="Resource" id="Resource_oilue"]
script = ExtResource("4_ch5i3")
