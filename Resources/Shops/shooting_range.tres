[sub_resource type="Resource" id="Resource_h0dk1"]
script = ExtResource("2_hth06")
path = "PlayerStats"
value = "shooting_level"
comparison = 1
value2 = 0
success_text = "Good to see you again. You're welcome to use our range any time."
fail_text = "Hey there, sharpshooter. We're hosting a shooting contest with a cash prize if you're interested."
metadata/_custom_type_script = "uid://d36xpf3aobxt1"

[sub_resource type="Resource" id="Resource_48ogp"]
script = ExtResource("2_48ogp")
text = "Entry is $25. The prize is $50 if you can hit all the targets within the time limit. We'll provide the ammo, so don't worry about saving bullets."
metadata/_custom_type_script = "uid://de6rxup5nru4w"

[sub_resource type="Resource" id="Resource_oilue"]
script = ExtResource("5_dbbdt")
method = "create_notification"
arguments = ["You don't have enough money"]
metadata/_custom_type_script = "uid://ba3pwbmpdnwa8"

[sub_resource type="Resource" id="Resource_8x2d6"]
script = ExtResource("6_7yobo")
bubbles = Array[ExtResource("1_h0dk1")]([SubResource("Resource_oilue")])
metadata/_custom_type_script = "uid://brq5lvk7ek4ux"

[sub_resource type="Resource" id="Resource_ch5i3"]
script = ExtResource("5_dbbdt")
method = "pay_fee"
arguments = [24]
metadata/_custom_type_script = "uid://ba3pwbmpdnwa8"

[sub_resource type="Resource" id="Resource_ip6nd"]
script = ExtResource("5_dbbdt")
method = "change_scene"
arguments = ["res://Scenes/Levels/shooting_range.tscn"]
metadata/_custom_type_script = "uid://ba3pwbmpdnwa8"

[sub_resource type="Resource" id="Resource_ufi6q"]
script = ExtResource("6_7yobo")
bubbles = Array[ExtResource("1_h0dk1")]([SubResource("Resource_ch5i3"), SubResource("Resource_ip6nd")])
metadata/_custom_type_script = "uid://brq5lvk7ek4ux"

[sub_resource type="Resource" id="Resource_c3pbh"]
script = ExtResource("4_n3ys7")
path = "PlayerStats"
value = "money"
comparison = 1
value2 = 24
success_branch = SubResource("Resource_ufi6q")
failure_branch = SubResource("Resource_8x2d6")
metadata/_custom_type_script = "uid://cxdd8jo8xmqfb"

[sub_resource type="Resource" id="Resource_hth06"]
script = ExtResource("3_hth06")
text = "Pay"
