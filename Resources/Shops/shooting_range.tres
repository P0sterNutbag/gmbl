metadata/_custom_type_script = "uid://b2lfe52ud4ctk"

[sub_resource type="Resource" id="Resource_n3ys7"]
script = ExtResource("3_hth06")
text = "Return"
metadata/_custom_type_script = "uid://b2lfe52ud4ctk"

[sub_resource type="Resource" id="Resource_dbbdt"]
